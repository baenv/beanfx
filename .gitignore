# Skills other than beanfx, and their kits and drafts
.claude/*
!.claude/skills/
.claude/skills/*
!.claude/skills/beanfx
kit_char/
kit_scene/
/chars/
scenes/

# Generated
.DS_Store
out/
pixelfx/
.wrangler/
# Python leftovers from before 2.0.0 and the local /char and /scene kits
__pycache__/
*.pyc
.venv/
.coverage
.pytest_cache/

# Heavy media: keep only the JSON and scripts of each result
*.png
*.gif
*.jpg
*.jpeg
*.webp
*.mp4
*.webm
*.wav

# Recordings a project layers into its effect sounds (kit/src/sfx.rs); their licences vary
/sounds/

# Local only
site/
/casters/
# setup.sh --draft writes this machine-specific pointer
drafts/*/kit/skill.txt
/casters_archive/
/drafts_archive/
# the bundled game casters ship with the plugin (sheets and rig.json only)
!plugins/beanfx/skills/beanfx/casters/*/*.png

# README previews and the demo page's sheets
!docs/media/*.gif
!docs/media/*.png
!docs/demo/*.png
# the kit's image test fixtures (small PNGs read by kit/src/img.rs tests)
!plugins/beanfx/skills/beanfx/kit/tests/fixtures/**

# Personal task tracking
tasks/
PROGRESS.md

# Drafts: only the published examples are tracked; new drafts stay local (git add -f to publish one)
drafts/*
!drafts/hoa_cong_v2/

# cargo build output of the kit crate (plugins/beanfx/skills/beanfx/kit)
target/

# draft Rust builds share one target dir (drafts/<name>/.cargo/config.toml)
.beanfx/

# Eval runs
plugins/beanfx/evals/results/
